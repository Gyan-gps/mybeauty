# Copy to .env. Never commit credentials.
NEXT_MONGODB_URL=mongodb://127.0.0.1:27017/mybeauty
MONGODB_DB=mybeauty
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel: set these in Project Settings → Environment Variables.
# Use a MongoDB Atlas URL (allow Vercel's IPs, e.g. 0.0.0.0/0, or use the Atlas integration).
# NEXT_PUBLIC_SITE_URL can be left unset there; the Vercel production domain is used automatically.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_TTL_DAYS=7
# Email OTP delivery (required for returning-customer login)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
